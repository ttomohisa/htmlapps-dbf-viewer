{
  "$schema": "./schemas/app-config.schema.json",
  "name": "DBF Viewer",
  "nameJa": "DBF Viewer",
  "slug": "dbf-viewer",
  "version": "1.0.1",
  "description": "Open DBF files locally in your browser and inspect fields, records, encoding, and memo data.",
  "descriptionJa": "DBFファイルをブラウザー内で開き、フィールド構成・レコード・文字コード・メモデータを確認します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-dbf-viewer"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 10,
      "selfExtractWarningMb": 6
    }
  }
}
